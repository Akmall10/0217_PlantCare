PORT=3000

# Connection string dari Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Dipakai pada tahap autentikasi
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-string-acak-lain
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Akun admin awal (dipakai npm run seed)
ADMIN_NAMA=Admin Plant Care
ADMIN_EMAIL=admin@plantcare.local
ADMIN_PASSWORD=ganti-password-admin
